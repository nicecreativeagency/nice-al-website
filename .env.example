# Production: use the pooled Neon PostgreSQL connection string.
# Development: omit DATABASE_URL to use the local PGlite database in .data/.
DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002

# Used only by `npm run db:seed`. Public sign-up remains disabled.
DEV_ADMIN_EMAIL=admin@nice.al
DEV_ADMIN_PASSWORD=
DEV_CLIENT_EMAIL=client@nice.al
DEV_CLIENT_PASSWORD=
