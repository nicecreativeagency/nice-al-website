# Production: use the pooled Neon PostgreSQL connection string.
# Development: omit DATABASE_URL to use the local PGlite database in .data/.
DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002

# Cloudinary signed media uploads. Keep the API secret server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email notifications. Verify the sender domain in Resend first.
RESEND_API_KEY=
EMAIL_FROM=NICE Social Hub <hub@updates.nice.al>

# Used only by `npm run db:seed`. Public sign-up remains disabled.
DEV_ADMIN_EMAIL=admin@nice.al
DEV_ADMIN_PASSWORD=
DEV_CLIENT_EMAIL=client@nice.al
DEV_CLIENT_PASSWORD=
